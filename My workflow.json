    {
      "parameters": {
        "jsCode": "const newRows = $(\"Transformar en filas\").all();\nconst existingRows = $(\"Leer fechas existentes\").all();\n\nconst existingDates = new Set(\n  existingRows.map(item => item.json.Date)\n);\n\nconst filteredRows = newRows.filter(item => {\n  return !existingDates.has(item.json.Date);\n});\n\nreturn filteredRows;"
      },
