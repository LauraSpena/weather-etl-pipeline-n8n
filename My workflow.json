    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst daily = input.daily;\n\nconst rows = daily.time.map((date, index) => {\n  const dateKey = Number(date.replaceAll(\"-\", \"\"));\n\n  return {\n    json: {\n      Date: date,\n      DateKey: dateKey,\n      LocationID: 1,\n      Temperature_Mean_C: daily.temperature_2m_mean[index],\n      Temperature_Max_C: daily.temperature_2m_max[index],\n      Temperature_Min_C: daily.temperature_2m_min[index],\n      SolarIrradiance_MJ_m2: daily.shortwave_radiation_sum[index],\n      CloudCover_pct: daily.cloud_cover_mean[index],\n      WindSpeed_kmh: daily.wind_speed_10m_mean[index],\n      Source: \"Open-Meteo API\",\n      LoadDate: new Date().toISOString()\n    }\n  };\n});\n\nreturn rows;"
      },
